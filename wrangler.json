{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "cloudflare-demo",
    "main": ".output/server/index.mjs",
    "compatibility_date": "2024-09-23",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".output/public",
        "binding": "ASSETS"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "demo",
            "database_id": "55efcb6d-1bae-4f73-aa6d-6aa48abdb58f"
        }
    ],
    "observability": {
        "logs": {
            "enabled": false,
            "invocation_logs": true
        }
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "$DurableObject",
                "class_name": "$DurableObject"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": [
                "$DurableObject"
            ]
        }
    ]
}